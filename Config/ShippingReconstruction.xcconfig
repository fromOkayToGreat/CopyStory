// Build0 is an engineering placeholder, NOT an allocated distributable build.
PRODUCT_BUNDLE_IDENTIFIER = com.copystory.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 0
MACOSX_DEPLOYMENT_TARGET = 26.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
SUPPORTED_PLATFORMS = macosx
SDKROOT = macosx
SWIFT_VERSION = 5.0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) APP_STORE SHIPPING_RECONSTRUCTION
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_IDENTITY =
CODE_SIGN_ENTITLEMENTS = Config/AppStore.entitlements
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
INFOPLIST_FILE = Config/ShippingReconstruction-Info.plist
GENERATE_INFOPLIST_FILE = NO
SWIFT_INCLUDE_PATHS = $(inherited) $(SRCROOT)/Sources/CSQLite

COPYSTORY_APP_PRODUCT_NAME = CopyStory

// Production-only packaging; preserve reconstruction and development resources.
EXCLUDED_SOURCE_FILE_NAMES = CopyStory.icns PrivacyInfo.xcprivacy
