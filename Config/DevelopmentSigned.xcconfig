// Signed personal development only. Select explicitly; never used by shipping.
#include "Development.xcconfig"
CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = YES
CODE_SIGN_STYLE = Manual
// Supplied explicitly by build-signed-development.py; no implicit team selection.
DEVELOPMENT_TEAM = $(COPYSTORY_DEVELOPMENT_TEAM)
CODE_SIGN_IDENTITY = $(COPYSTORY_DEVELOPMENT_IDENTITY)
CODE_SIGN_ENTITLEMENTS = Config/AppStore.entitlements
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
// Current sandbox-only entitlement is unrestricted on macOS (Apple TN3125).
PROVISIONING_PROFILE_SPECIFIER =
CURRENT_PROJECT_VERSION = $(COPYSTORY_DEVELOPMENT_BUILD_NUMBER)
